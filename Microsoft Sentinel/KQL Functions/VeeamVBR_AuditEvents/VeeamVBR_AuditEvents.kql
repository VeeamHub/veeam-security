// VeeamVBR_AuditEvents: parses Veeam B&R security and audit events from the Syslog table
// Save as a function in Log Analytics (Save > Save as function, name: VeeamVBR_AuditEvents)
let EventNames = datatable(EventId:int, EventName:string, Category:string)
[
    40100, "Console Launched", "Access",
    40101, "Console Closed", "Access",
    44002, "User Authorization Denied", "Access",
    44003, "User Authorization Granted", "Access",
    44004, "Password Change Required", "Access",
    44005, "Token Chain Revoked", "Access",
    44006, "Resource Access Denied", "Access",
    40200, "MFA Enabled", "MFA",
    40201, "MFA Disabled", "MFA",
    40202, "MFA Token Revoked", "MFA",
    40203, "MFA for User Enabled", "MFA",
    40204, "MFA for User Disabled", "MFA",
    40205, "Invalid MFA Code Entered", "MFA",
    40206, "MFA Attempts Exceeded", "MFA",
    40207, "MFA Code Already Used", "MFA",
    31200, "User or Group Added", "Users",
    31210, "Adding User or Group Failed", "Users",
    31400, "User or Group Deleted", "Users",
    31300, "Custom Role Added", "Users",
    31310, "Custom Role Updated", "Users",
    31320, "Custom Role Deleted", "Users",
    42800, "SAML Settings Updated", "Users",
    42400, "Four-Eyes Enabled", "FourEyes",
    42401, "Four-Eyes Disabled", "FourEyes",
    42402, "Four-Eyes Request Created", "FourEyes",
    42403, "Four-Eyes Request Approved", "FourEyes",
    42404, "Four-Eyes Request Rejected", "FourEyes",
    42405, "Four-Eyes Request Expired", "FourEyes",
    10050, "Restore Point Deleted", "Deletion",
    23090, "Job Deleted", "Deletion",
    28200, "Backup Repository Deleted", "Deletion",
    41402, "Storage Deleted", "Deletion",
    41800, "Attempt to Delete Backup Failed", "Deletion",
    41810, "Attempt to Update Security Object Failed", "Deletion",
    41200, "Detaching Backups Started", "Deletion",
    41202, "Moving Backups Started", "Deletion",
    25300, "Credential Record Added", "Credentials",
    25400, "Credential Record Updated", "Credentials",
    25500, "Credential Record Deleted", "Credentials",
    31700, "Encryption Password Updated", "Credentials",
    31800, "Encryption Password Deleted", "Credentials",
    31900, "SSH Credentials Changed", "Credentials",
    42301, "KMS Server Deleted", "Credentials",
    42302, "KMS Server Settings Updated", "Credentials",
    41600, "Malware Activity Detected", "Malware",
    41610, "Object Marked as Clean", "Malware",
    42220, "Restore Point Marked as Infected", "Malware",
    42230, "Restore Point Marked as Clean", "Malware",
    42260, "Objects Added to Malware Exclusions", "Malware",
    42280, "Malware Exclusions List Updated", "Malware",
    42290, "Malware Detection Settings Updated", "Malware",
    210, "Restore Session Started", "Restore",
    40210, "Restore Session Started", "Restore",
    290, "Restore Session Finished", "Restore",
    40290, "Restore Session Finished", "Restore",
    41500, "Restore Point Mounted", "Restore",
    41510, "Restore Point Unmounted", "Restore",
    31000, "General Settings Updated", "Config",
    31500, "Configuration Backup Settings Updated", "Config",
    40700, "Configuration Backup Job Finished", "Config",
    40800, "Configuration Restore Finished", "Config",
    40400, "Global VM Exclusions Added", "Config",
    40600, "Global VM Exclusions Changed", "Config",
    40500, "Global VM Exclusions Deleted", "Config",
    28100, "Backup Repository Settings Updated", "Config",
    23050, "Job Settings Updated", "Config",
    23130, "Objects for Job Changed", "Config",
    42902, "Best Practice Suppressed", "Config",
    42900, "Security Analyzer Session Finished", "Config",
    24080, "License Removed", "Config",
    43004, "HA Cluster Failover Started", "Config"
];
Syslog
| where SyslogMessage has "instanceId"
| extend EventId = toint(extract(@'instanceId="?(\d+)', 1, SyslogMessage))
| extend Pairs = extract_all(@'(\w+)="((?:[^"\\]|\\.)*)"', SyslogMessage)
| mv-apply Pair = Pairs on (
    summarize Fields = make_bag(bag_pack(tostring(Pair[0]),
        replace_regex(tostring(Pair[1]), @'\\(["\\\]])', @'\1')))
  )
| join kind=inner EventNames on EventId
| extend
    User      = coalesce(tostring(Fields.UserName), tostring(Fields.FriendlyName),
                         tostring(Fields.UserFullInfo), tostring(Fields.InitiatorFullInfo)),
    UserSid   = tostring(Fields.Subject),
    SourceIp  = tostring(Fields.SourceIpAddress),
    Object    = coalesce(tostring(Fields.ObjectName), tostring(Fields.VmName),
                         tostring(Fields.JobName), tostring(Fields.Name)),
    Operation = tostring(Fields.Operation),
    Reason    = tostring(Fields.Reason),
    VbrServer = coalesce(tostring(Fields.VbrHostName), HostName),
    VbrVersion = tostring(Fields.VbrVersion),
    Message   = tostring(Fields.Description)
| project EventTime, VbrServer, EventId, EventName, Category, SeverityLevel,
          User, UserSid, SourceIp, Object, Operation, Reason, Message, Fields, VbrVersion
